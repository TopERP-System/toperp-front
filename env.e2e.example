# Copie para .env.e2e (ignorado pelo git) e preencha. Ver e2e/README.md.

# Usuário do banco LOCAL usado nos testes com login
E2E_EMAIL=
E2E_SENHA=

# Opcionais
# E2E_API_URL=http://localhost:4000/api/v1   # API usada pelos specs "-local" para criar/excluir dados
# E2E_SLOWMO=350                             # atraso (ms) entre ações nos specs com vídeo
# E2E_BASE_URL=http://localhost:8080         # front já rodando em outra URL (não sobe o Vite)
